+    def _read_joint_torque(self) -> np.ndarray:
+        robot = self.env.scene["robot"]
+        torque = getattr(robot.data, "applied_torque", None)
+        if torque is None:
+            torque = getattr(robot.data, "joint_effort", None)
+        if torque is None:
+            raise AttributeError("robot.data has neither applied_torque nor joint_effort")
+        return torque[0].detach().cpu().numpy().astype(np.float32)
+
+    def _append_current_gripper_torque(self) -> None:
+        torque = self._read_joint_torque()
+        if torque.shape[0] < 2:
+            raise ValueError(f"Expected at least two gripper joints, got torque shape {torque.shape}")
+        value = np.array([float(torque[-2:].mean())], dtype=np.float32)
+        self._gripper_torque_history.append(value)
+        self._gripper_torque_history = self._gripper_torque_history[-self.torque_window_size :]
+
+    def _get_padded_gripper_torque_window(self) -> np.ndarray:
+        if not self._gripper_torque_history:
+            raise RuntimeError("Torque history is empty")
+        history = np.stack(self._gripper_torque_history, axis=0).astype(np.float32)
+        pad_count = self.torque_window_size - history.shape[0]
+        if pad_count > 0:
+            history = np.concatenate([np.repeat(history[:1], pad_count, axis=0), history], axis=0)
+        return history
     
