+def _asset_path(remote_path: str) -> str:
+    """Resolve an Isaac 4.5 asset path.
+
+    If LOCAL_ISAAC_4_5_ASSET_ROOT is set, map URLs under the Isaac 4.5 asset
+    root to a local mirror. Otherwise preserve the original Nucleus/S3 path.
+    """
+    if _LOCAL_ISAAC_4_5_ASSET_ROOT:
+        marker = "/Assets/Isaac/4.5/"
+        if marker in remote_path:
+            rel = remote_path.split(marker, 1)[1]
+        else:
+            rel = remote_path.split("/Isaac/", 1)[-1]
+            rel = f"Isaac/{rel}" if not rel.startswith("Isaac/") else rel
+        return os.path.join(_LOCAL_ISAAC_4_5_ASSET_ROOT, rel)
+    return remote_path
