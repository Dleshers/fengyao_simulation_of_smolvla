diff --git a/src/lerobot/scripts/lerobot_eval.py b/src/lerobot/scripts/lerobot_eval.py
--- a/src/lerobot/scripts/lerobot_eval.py
+++ b/src/lerobot/scripts/lerobot_eval.py
@@
+def _coerce_success_list(value: Any, num_envs: int) -> list[bool] | None:
+    """Convert scalar/list/array success payloads to one bool per env."""
+    if value is None:
+        return None
+    if isinstance(value, torch.Tensor):
+        value = value.detach().cpu().numpy()
+    arr = np.asarray(value, dtype=bool)
+    if arr.ndim == 0:
+        return [bool(arr.item())] * num_envs
+    arr = arr.reshape(-1)
+    if arr.size == num_envs:
+        return [bool(x) for x in arr.tolist()]
+    if arr.size == 1:
+        return [bool(arr.item())] * num_envs
+    return None
+
+
+def _extract_successes_from_info(info: dict[str, Any], num_envs: int) -> list[bool]:
+    """Read task success from Gymnasium and IsaacLab remote-env info payloads."""
+    final_info = info.get("final_info")
+    if final_info is not None:
+        if isinstance(final_info, dict):
+            successes = _coerce_success_list(final_info.get("is_success"), num_envs)
+            if successes is None:
+                successes = _coerce_success_list(final_info.get("success"), num_envs)
+            if successes is not None:
+                return successes
+        elif isinstance(final_info, (list, tuple, np.ndarray)):
+            values = []
+            for item in list(final_info):
+                if isinstance(item, dict):
+                    values.append(bool(item.get("is_success", item.get("success", False))))
+                else:
+                    values.append(False)
+            if len(values) == num_envs:
+                return values
+        else:
+            raise RuntimeError(
+                "Unsupported `final_info` format: expected dict/list/array with is_success values."
+            )
+
+    for key in ("is_success", "success"):
+        successes = _coerce_success_list(info.get(key), num_envs)
+        if successes is not None:
+            return successes
+
+    return [False] * num_envs
+
