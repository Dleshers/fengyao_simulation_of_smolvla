 import isaaclab_tasks  # noqa: F401
 from isaaclab_tasks.utils.parse_cfg import parse_env_cfg
 from isaaclab.utils.assets import NVIDIA_NUCLEUS_DIR
 
 
+def _parse_fixed_cube_pose(spec: Optional[str], device: str) -> Optional[torch.Tensor]:
+    if spec is None or str(spec).strip() == "":
+        return None
+    values = [float(part.strip()) for part in str(spec).split(",") if part.strip()]
+    if len(values) == 3:
+        values = values + [1.0, 0.0, 0.0, 0.0]
+    if len(values) != 7:
+        raise ValueError(
+            "--fixed_cube_pose must be x,y,z or x,y,z,qw,qx,qy,qz; "
+            f"got {len(values)} values from {spec!r}"
+        )
+    return torch.tensor(values, dtype=torch.float32, device=device).unsqueeze(0)
+
+
+def _apply_fixed_cube_pose(env, fixed_cube_pose: Optional[torch.Tensor], env_ids=None) -> None:
+    if fixed_cube_pose is None:
+        return
+    cube = env.scene["cube"]
+    if env_ids is None:
+        env_ids_tensor = torch.arange(env.num_envs, dtype=torch.long, device=env.device)
+    else:
+        env_ids_tensor = torch.as_tensor(env_ids, dtype=torch.long, device=env.device)
+    if env_ids_tensor.numel() == 0:
+        return
+    pose_w = fixed_cube_pose.repeat(env_ids_tensor.numel(), 1)
+    pose_w[:, :3] += env.scene.env_origins[env_ids_tensor]
+    cube.write_root_pose_to_sim(pose_w, env_ids=env_ids_tensor)
+    cube.write_root_velocity_to_sim(
+        torch.zeros((env_ids_tensor.numel(), 6), dtype=torch.float32, device=env.device),
+        env_ids=env_ids_tensor,
+    )
+    env.sim.forward()
+
+
 def _compute_pseudo_force_geometric(height_map: torch.Tensor) -> torch.Tensor:
