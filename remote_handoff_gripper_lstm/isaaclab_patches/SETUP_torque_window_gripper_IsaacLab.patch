+def _compute_local_force_grid_from_height_map(height_map: torch.Tensor) -> np.ndarray:
+    """Compute a local 10x12x3 pseudo-force grid from tactile height map.
+
+    This mirrors the eval-time tactile representation:
+    - Fx/Fy come from normalized deformation gradients
+    - Fz comes from normalized deformation depth
+    """
+    hmap = height_map.detach().cpu().numpy().astype(np.float32)
+    baseline = float(hmap.max())
+    deformation = np.clip(baseline - hmap, 0.0, None)
+    grad_y, grad_x = np.gradient(deformation)
+
+    grad_x = np.clip(grad_x / (np.abs(grad_x).max() + 1e-6), -1.0, 1.0)
+    grad_y = np.clip(grad_y / (np.abs(grad_y).max() + 1e-6), -1.0, 1.0)
+    fz = deformation / (deformation.max() + 1e-6)
+
+    return np.stack(
+        [
+            cv2.resize(grad_x, (12, 10), interpolation=cv2.INTER_LINEAR),
+            cv2.resize(grad_y, (12, 10), interpolation=cv2.INTER_LINEAR),
+            cv2.resize(fz, (12, 10), interpolation=cv2.INTER_LINEAR),
+        ],
+        axis=-1,
+    ).astype(np.float32)
+
+
