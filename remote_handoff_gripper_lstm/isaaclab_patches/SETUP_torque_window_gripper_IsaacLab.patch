+def build_force_grid_photometric_rgb(left_rgb: np.ndarray, right_rgb: np.ndarray, out_h: int, out_w: int) -> np.ndarray:
+    """Downsample raw TacEx tactile RGB images to a two-finger RGB grid in [0, 1]."""
+
+    grids = []
+    for rgb in (left_rgb, right_rgb):
+        arr = np.asarray(rgb)
+        if arr.ndim != 3 or arr.shape[-1] < 3:
+            raise ValueError(f"Expected tactile RGB image HWC with 3 channels, got shape={arr.shape}")
+        arr = arr[..., :3].astype(np.float32)
+        if arr.max(initial=0.0) > 1.5:
+            arr = arr / 255.0
+        arr = np.clip(arr, 0.0, 1.0)
+        grids.append(cv2.resize(arr, (out_w, out_h), interpolation=cv2.INTER_AREA))
+    return np.stack(grids, axis=0).astype(np.float32)
+
+
+def build_resultant_force_photometric_rgb(left_rgb: np.ndarray, right_rgb: np.ndarray) -> np.ndarray:
+    """Compute the photometric resultant-force feature used by the current LeRobot dataset."""
+
+    forces = []
+    for rgb in (left_rgb, right_rgb):
+        arr = np.asarray(rgb)
+        if arr.ndim != 3 or arr.shape[-1] < 3:
+            raise ValueError(f"Expected tactile RGB image HWC with 3 channels, got shape={arr.shape}")
+        arr = arr[..., :3].astype(np.float32)
+        if arr.max(initial=0.0) > 1.5:
+            arr = arr / 255.0
+        arr = np.clip(arr, 0.0, 1.0)
+        centered = arr - 0.5
+        rgb_deviation = float(np.abs(centered).mean())
+        shear_scale = 4.0
+        normal_scale = 2.0
+        forces.append(
+            np.array(
+                [
+                    float(centered[..., 0].mean()) * rgb_deviation * shear_scale,
+                    float(centered[..., 1].mean()) * rgb_deviation * shear_scale,
+                    rgb_deviation * normal_scale,
+                ],
+                dtype=np.float32,
+            )
+        )
+    return np.stack(forces, axis=0).astype(np.float32)
+
